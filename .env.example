# Kumbh Setu — environment variables
#
# The app runs FULLY on local/simulated providers with NO keys and NO config.
# Everything below is opt-in: set it only to route Setu's reasoning, speech,
# translation and TTS through real Sarvam AI. Copy this file to `.env`
# (gitignored) and fill in real values — never commit `.env`.
#
# When a real call fails for any reason, the matching Mock* provider takes over
# automatically, so the demo never hard-breaks.

# ── 1. Turn the real path ON ────────────────────────────────────────────────
# Public, non-secret. Flips src/ai/providers to the Sarvam adapters.
# Leave unset (or not "1") to stay 100% on local/simulated providers.
NEXT_PUBLIC_SETU_LIVE=

# ── 2. Sarvam credentials (SERVER ONLY — never exposed to the browser) ──────
# Held only by the /api/setu/* route handlers. Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_API_BASE=https://api.sarvam.ai

# ── 3. Per-capability opt-in ──────────────────────────────────────────────
# Set each to "sarvam" to use the real provider for that capability; anything
# else keeps the local/simulated one. Requires SARVAM_API_KEY to be set.
AI_PROVIDER=sarvam            # Setu reasoning / tool selection  -> /api/setu/chat
TRANSLATION_PROVIDER=sarvam   # multilingual translation         -> /api/setu/translate
SPEECH_PROVIDER=sarvam        # batch STT (no-Web-Speech fallback)-> /api/setu/stt
TTS_PROVIDER=sarvam           # spoken replies                   -> /api/setu/tts

# ── 4. Model IDs (optional — track Sarvam's catalogue without a code change) ─
SARVAM_CHAT_MODEL=sarvam-m
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2

# ── 5. Generic OpenAI-compatible fallback reasoning endpoint (optional) ─────
# Not required. Left here for a self-hosted / alternative LLM if desired.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── 6. Volunteer WhatsApp group (optional) ─────────────────────────────────
# Or set it directly in src/lib/volunteerProgram.ts
# VOLUNTEER_WHATSAPP_INVITE=https://chat.whatsapp.com/XXXXXXXXXXXX
