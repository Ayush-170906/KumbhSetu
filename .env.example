# Kumbh Setu — environment variables (all OPTIONAL)
#
# The app runs fully on local mock providers with NO keys. Set these only to
# plug a real speech / translation / LLM service in behind the provider
# interface (src/ai/providers/). Copy to `.env` (which is gitignored) and fill
# in real values — never commit `.env`.

# --- Sarvam AI (speech-to-text, text-to-speech, translation, chat for Indian
#     languages). Get a key at https://indus.sarvam.ai
SARVAM_API_KEY=
SARVAM_API_BASE=https://api.sarvam.ai

# --- Generic OpenAI-compatible chat endpoint (fallback reasoning provider).
#     Works with OpenAI, Azure OpenAI, Together, Groq, a local llama.cpp server,
#     etc. Leave OPENAI_API_KEY blank to stay on the mock reasoning engine.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
